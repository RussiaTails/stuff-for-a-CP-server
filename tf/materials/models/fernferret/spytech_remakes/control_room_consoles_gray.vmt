"VertexLitGeneric"
{
	"$basetexture" "models\fernferret\spytech_remakes\control_room_consoles_gray"
	"$selfillum" 1
	"$nodecal" "1"

	// Use separate self-illum mask on Pre DX9 hardware
	">=DX90"
	{
		"$baseTexture" 		"models\fernferret\spytech_remakes\control_room_consoles_gray_noalpha"
		"$selfillummask" 	"Models/props_spytech/control_room_consoles_selfillum"
	}

	// Use redundant self-illum in base alpha on Pre DX9 hardware
	"<DX90"
	{
		"$baseTexture" 	"models\fernferret\spytech_remakes\control_room_consoles_gray"
	}
}
